rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
   // 1. Ensure your Room rules are intact
    match /rooms/{roomId} {
      allow read, write: if true; // ⚠️ Adjust this based on your actual room auth needs
      
      // 2. Add this specific block for your nested players subcollection
      match /players/{playerName} {
        // Enforce the uniqueness constraint: only allow creation if doc doesn't exist
        allow create: if resource == null;
        
        // Allow reading and updating player scores/answers during the game
        allow read, update, delete: if true; 
      }

      // 3.
      match /questions/{questionId} {
        // Enforce the uniqueness constraint: only allow creation if doc doesn't exist
        allow create: if resource == null;
        
        // Allow reading question details during the game
        allow read: if true; 
      }
    }
  }
}